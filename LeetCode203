class Solution {
    public ListNode removeElements(ListNode head, int val) {
        if(head == null) return head;

        ListNode temp1 = head;
        ListNode dummy = new ListNode(0);
        ListNode temp = dummy;

        while(temp1 != null){
            if(temp1.val == val){
                temp1 = temp1.next;
            } else {
                ListNode next = temp1.next;

                temp.next = temp1;
                temp = temp.next;

                temp1.next = null;
                temp1 = next;
            }
        }

        return dummy.next;
    }
}
