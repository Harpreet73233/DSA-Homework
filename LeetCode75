import java.util.*;

public class LeetCode75 {

    public void sortColors(int[] nums) {

        int zero = 0;
        int one = 0;
        int two = 0;

        // Count 0s, 1s and 2s
        for (int num : nums) {
            if (num == 0) {
                zero++;
            } else if (num == 1) {
                one++;
            } else {
                two++;
            }
        }

        // Put 0s
        int i = 0;

        while (zero > 0) {
            nums[i] = 0;
            i++;
            zero--;
        }

        // Put 1s
        while (one > 0) {
            nums[i] = 1;
            i++;
            one--;
        }

        // Put 2s
        while (two > 0) {
            nums[i] = 2;
            i++;
            two--;
        }
    }

    public static void main(String[] args) {

        LeetCode75 obj = new LeetCode75();

        int[] nums = {2, 0, 2, 1, 1, 0};

        obj.sortColors(nums);

        System.out.println(Arrays.toString(nums));
    }
}
