/* Structure of Binary Tree Node
class Node {
    int data;
    Node left, right;
    Node(int d)
    {
        data = d;
        left = right = null;
    }
}*/

class Solution {
    ArrayList<Integer> zigZagTraversal(Node root) {
        // code here
        ArrayList<Integer> arr = new ArrayList<>();
        
        if(root == null)
            return arr;
        
        
        Queue<Node> q = new LinkedList<>();
        q.add(root);
        
        boolean ltr = true;
        
        while(!q.isEmpty()){
            int size = q.size();
            List<Integer> l = new ArrayList<>();
            
            for(int i = 0; i < size; i++){
                Node curr = q.poll();
                l.add(curr.data);
                
                if(curr.left != null){
                    q.add(curr.left);
                }
                
                if(curr.right != null){
                    q.add(curr.right);
                }
            }
            if(!ltr){
                Collections.reverse(l);
            }
            
            arr.addAll(l);
            ltr = !ltr;
        }
        
        return arr;
    }
}
