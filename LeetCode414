class Solution {
    public int thirdMax(int[] nums) {
        // Arrays.sort(nums);
        Set<Integer> s = new HashSet<>();
        for(int i : nums){
            s.add(i);
        }

        ArrayList<Integer> list = new ArrayList<>(s);
        Collections.sort(list);
        if(list.size() < 3){
            return list.get(list.size() -1);
        }
        return list.get(list.size() - 3);
    }
}
