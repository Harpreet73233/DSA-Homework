class Solution {
    public boolean isAnagram(String s, String t) {
        

        char[] ch = s.toCharArray();
        char[] ch2 = t.toCharArray();

        if(ch.length != ch2.length) return false;

        int[] freq = new int[26];

        for(char c : ch){
            freq[c - 'a']++;
        }

        for(char c : ch2){
            if(freq[c - 'a'] == 0) return false;
            freq[c - 'a']--;
        }

        return true;
    }
}
