class Solution {
    public int[] minOperations(String boxes) {

        int[] arr = new int[boxes.length()];
        int index = 0;

        char[] temp = boxes.toCharArray();
        for(int i = 0; i < temp.length; i++){
            int sum = 0;
            for(int j = 0; j < temp.length; j++){
                if(temp[j] == '1'){
                    sum += Math.abs(i - j);
                }
            }

            arr[index] = sum;
            index++;
        }

        return arr;
    }
}
