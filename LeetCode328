class Solution {
    public ListNode oddEvenList(ListNode head) {
        ListNode odd = new ListNode(0);
        ListNode temp1 = odd;

        ListNode even = new ListNode(0);
        ListNode temp2 = even;

        ListNode temp = head;
        int count = 1;

        while(temp != null){
            if(count % 2 != 0){
                ListNode next = temp.next;
                temp1.next = temp;

                temp1 = temp1.next;

                temp.next = null;
                temp = next;

            } else {
                ListNode next = temp.next;
                temp2.next = temp;

                temp2 = temp2.next;

                temp.next = null;
                temp = next;
            }
            count++;
        }

        temp1.next = even.next;

        return odd.next;
    }
}
