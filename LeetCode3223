class Solution {
    public int minimumLength(String s) {
        int[] freq = new int[26];

        for(char ch : s.toCharArray()){
            freq[ch - 'a']++;
        }

        int ans = 0;

        for(int f : freq){
            if(f > 0){
                if(f % 2 == 0){
                    ans += 2;
                } else {
                    ans += 1;
                }
            }
        }

        return ans;

    }
}
