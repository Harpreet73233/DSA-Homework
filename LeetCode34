class Solution {
    public int[] searchRange(int[] nums, int target) {
        int sindex = -1;
        int eindex = -1;

        for(int i = 0; i < nums.length; i++){
            if(nums[i] == target){
                sindex = i;
                break;
            }
        }

        for(int i = 0; i < nums.length; i++){
            if(nums[i] == target){
                eindex = i;
            }
        }

        int[] arr = {sindex, eindex};

        return arr;
    }
}
